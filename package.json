{
  "name": "ics-calendar-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Privacy-first, read-only MCP server for ICS calendar availability and free-slot discovery",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:local": "wrangler deploy -c wrangler.local.jsonc"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.3",
    "@modelcontextprotocol/server": "^2.3.1",
    "agents": "^0.28.1",
    "ical.js": "^2.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261014.1",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.3.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4",
    "wrangler": "^4.150.0",
    "@cloudflare/vitest-plugin": "^1.4.1"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true,
    "core-js-pure": false
  }
}
